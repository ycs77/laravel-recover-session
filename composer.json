{
    "name": "ycs77/laravel-recover-session",
    "description": "Recover Laravel session when form post back from third-party API.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Lucas Yang",
            "email": "yangchenshin77@gmail.com"
        }
    ],
    "homepage": "https://github.com/ycs77/laravel-recover-session",
    "require": {
        "php": ">=8.2",
        "illuminate/cache": ">=11.0",
        "illuminate/config": ">=11.0",
        "illuminate/contracts": ">=11.0",
        "illuminate/encryption": ">=11.0",
        "illuminate/http": ">=11.0",
        "illuminate/session": ">=11.0",
        "illuminate/support": ">=11.0",
        "symfony/http-foundation": ">=7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": ">=9.0",
        "pestphp/pest": ">=2.36",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Ycs77\\LaravelRecoverSession\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ycs77\\LaravelRecoverSession\\Tests\\": "tests"
        }
    },
    "scripts": {
        "refacto": "php vendor/bin/rector",
        "lint": "php vendor/bin/pint --parallel",
        "test:refacto": "php vendor/bin/rector --dry-run",
        "test:lint": "php vendor/bin/pint --parallel --test",
        "test:analyse": "php vendor/bin/phpstan analyse --ansi",
        "test:unit": "php vendor/bin/pest",
        "test": [
            "@test:refacto",
            "@test:lint",
            "@test:analyse",
            "@test:unit"
        ],
        "post-autoload-dump": [
            "@php vendor/bin/testbench package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ycs77\\LaravelRecoverSession\\RecoverSessionServiceProvider"
            ],
            "aliases": {
                "RecoverSession": "Ycs77\\LaravelRecoverSession\\Facades\\RecoverSession"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
